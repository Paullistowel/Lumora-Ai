{
  "name": "lume-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma db push",
    "db:push": "prisma db push",
    "db:deploy": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:analyze": "tsx prisma/analyze.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed && npm run db:analyze",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "fetch-model": "bash scripts/fetch-model.sh",
    "gen:assets": "node scripts/generate-assets.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.7.1",
    "@neon/env": "^1.4.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.23.1",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "next": "16.2.10",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "sharp@0.32.6": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "protobufjs@6.11.6": true,
    "unrs-resolver@1.12.2": true
  }
}
